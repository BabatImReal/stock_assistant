# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- SSI FastConnect: PAUSED (doc §7.5, "Data source decision 2026-09-22") ---
# Registration costs money and nothing is paid for until the system proves
# effective. Kept here, commented out, so re-enabling is a one-line change
# rather than an archaeology exercise.
# SSI_CONSUMER_ID=
# SSI_CONSUMER_SECRET=

# --- vnstock, the free community tier (reference source only) ---------------
# Optional. The community tier works unregistered; registering raises the rate
# limit to 60 calls/min. Leave blank if you have not registered.
VNSTOCK_API_KEY=

# Local database (docker-compose.yml). These are local-only development
# defaults, not secrets - but they still live here rather than in code so the
# port or password can be changed without editing docker-compose.yml.
POSTGRES_USER=vnstock
POSTGRES_PASSWORD=vnstock
POSTGRES_DB=vnstock
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vnstock:vnstock@localhost:5432/vnstock
